@using Microsoft.EntityFrameworkCore
@inject Cinema_Ticket_Management_System.Data.CinemaDbContext Db
@{
    var section = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var runDay = DateOnly.FromDateTime(Display.LocalNow);
    var genres = await Db.Movies.AsNoTracking().Where(m => m.ShowingEnd >= runDay).Select(m => m.Genre).Distinct().OrderBy(g => g).ToListAsync();
    var activeGenre = section == "Movies" ? Context.Request.Query["genre"].ToString() : null;
    string Nav(string name) => section == name ? "nav-item active" : "nav-item";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d10" />
    <title>@ViewData["Title"] · CineDesk</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<svg class="icon-defs" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
<symbol id="i-reel" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="7" r="1.8"/><circle cx="12" cy="17" r="1.8"/><circle cx="7" cy="12" r="1.8"/><circle cx="17" cy="12" r="1.8"/></symbol>
<symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
<symbol id="i-trend" viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-10m-6 0h6v6"/></symbol>
<symbol id="i-alert" viewBox="0 0 24 24"><path d="m12 3 10 18H2L12 3ZM12 9v5m0 3v1"/></symbol>
<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
<symbol id="i-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
<symbol id="i-film" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 3v18M17 3v18M3 8h4M3 16h4M17 8h4M17 16h4M7 12h10"/></symbol>
<symbol id="i-ticket" viewBox="0 0 24 24"><path d="M3 5h18v5a2 2 0 0 0 0 4v5H3v-5a2 2 0 0 0 0-4V5ZM15 5v3m0 3v2m0 3v3"/></symbol>
<symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18"/></symbol>
<symbol id="i-seat" viewBox="0 0 24 24"><path d="M6 13V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8M3 11v7h18v-7M6 14h12M6 18v3m12-3v3"/></symbol>
<symbol id="i-play" viewBox="0 0 24 24"><path d="m9 5 11 7-11 7V5Z"/></symbol>
</defs></svg>

<aside class="sidebar">
    <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="CineDesk dashboard"><span class="brand-mark"><svg class="icon"><use href="#i-reel"/></svg></span>CINEDESK</a>
    <div class="nav-label">MENU</div>
    <nav aria-label="Main navigation">
        <a class="@Nav("Dashboard")" asp-controller="Dashboard" asp-action="Index" aria-current="@(section == "Dashboard" ? "page" : null)"><svg class="icon"><use href="#i-grid"/></svg>Dashboard</a>
        <a class="@Nav("Movies")" asp-controller="Movies" asp-action="Index" aria-current="@(section == "Movies" ? "page" : null)"><svg class="icon"><use href="#i-film"/></svg>Movies</a>
        <a class="@Nav("Showtimes")" asp-controller="Showtimes" asp-action="Index" aria-current="@(section == "Showtimes" ? "page" : null)"><svg class="icon"><use href="#i-calendar"/></svg>Showtimes</a>
        <a class="@Nav("Bookings")" asp-controller="Bookings" asp-action="Index" aria-current="@(section == "Bookings" ? "page" : null)"><svg class="icon"><use href="#i-ticket"/></svg>Bookings</a>
    </nav>
    <div class="sidebar-cta">
        <span class="eyebrow">Box office</span>
        <strong>Sell a ticket</strong>
        <p>Pick a showing, choose seats, print the ticket.</p>
        <a class="btn btn-primary btn-full" asp-controller="Showtimes" asp-action="Index"><svg class="icon"><use href="#i-ticket"/></svg>New booking</a>
    </div>
    <div class="sidebar-foot"><span class="status-dot"></span>SQL Server · connected</div>
</aside>

<div class="app-shell">
    <header class="topbar">
        <form class="top-search" method="get" asp-controller="Movies" asp-action="Index" role="search">
            <svg class="icon"><use href="#i-search"/></svg>
            <input name="search" value="@(section == "Movies" ? Context.Request.Query["search"].ToString() : "")" placeholder="Search movies…" aria-label="Search movies" />
        </form>
        <nav class="genre-chips" aria-label="Browse by genre">
            <a class="chip @(section == "Movies" && string.IsNullOrEmpty(activeGenre) ? "active" : "")" asp-controller="Movies" asp-action="Index">All movies</a>
            @foreach (var g in genres)
            {
                <a class="chip @(g == activeGenre ? "active" : "")" asp-controller="Movies" asp-action="Index" asp-route-genre="@g">@g</a>
            }
        </nav>
        <div class="user-chip"><span class="avatar">BO</span><span><strong>Box Office</strong><small>@Display.LocalNow.ToString("ddd, dd MMM · HH:mm", CultureInfo.InvariantCulture)</small></span></div>
    </header>
    <main id="main" tabindex="-1">
        @if (TempData["Success"] is string success) { <div class="notice success" role="status"><svg class="icon"><use href="#i-check"/></svg>@success</div> }
        @if (TempData["Error"] is string error) { <div class="notice error" role="alert"><svg class="icon"><use href="#i-alert"/></svg>@error</div> }
        @RenderBody()
        <footer class="page-footer"><span>CineDesk · Cinema ticket management</span><span>Cinema time: @Display.Zone.Id · Posters: Wikipedia</span></footer>
    </main>
</div>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
